{
  "route": {
    "rules": [
      {
        "process_name": [
          "WeChat.exe",
          "WeChat",
          "QQ.exe",
          "AliPay.exe",
          "League of Legends.exe"
        ],
        "outbound": "direct"
      },
      {
        "process_name": ["Discord.exe", "Telegram.exe", "Spotify.exe"],
        "outbound": "proxy"
      },
      {
        "rule_set": ["geosite-cn", "geoip-cn"],
        "outbound": "direct"
      }
    ],
    "final": "proxy"
  }
}
